{
  "name": "@archastro/react-shot",
  "version": "0.2.1",
  "description": "Capture deterministic PNG screenshots from React and TSX fixtures",
  "keywords": [
    "react",
    "screenshot",
    "playwright",
    "tsx",
    "visual-testing"
  ],
  "homepage": "https://github.com/ArchAstro/astroshots#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArchAstro/astroshots.git",
    "directory": "packages/react-shot"
  },
  "bugs": {
    "url": "https://github.com/ArchAstro/astroshots/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "bin": {
    "react-shot": "bin/react-shot.mjs"
  },
  "files": [
    "bin",
    "dist",
    "host",
    "README.md"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run src/meta.test.ts",
    "test:e2e": "npm run build && vitest run src/cli.e2e.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "1.61.1",
    "tsx": "^4.19.0",
    "vite": "^6.2.0",
    "yaml": "^2.7.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.9"
  }
}
